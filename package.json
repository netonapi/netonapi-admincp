{
  "name": "neton-application-front",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @neton/application-front-shell dev",
    "build": "pnpm --filter @neton/application-front-shell build",
    "typecheck": "pnpm registry && pnpm check:locales && pnpm --filter @neton/application-front-shell typecheck",
    "registry": "tsx scripts/generate-registry.mts",
    "check:locales": "tsx scripts/check-locales.mts",
    "test": "pnpm --filter @neton/application-front-runtime test"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  }
}
